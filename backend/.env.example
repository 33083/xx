# ===== 应用 =====
APP_NAME=大学生学习与求职智能助手
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== MySQL（Docker compose: campus-mysql:3306，root/campus123）=====
# 切换到本地 MySQL 改这里即可
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=campus123
MYSQL_DATABASE=campus_assistant

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== JWT（生产环境务必改成长随机串）=====
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 跨域 =====
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== Chroma 嵌入式向量库 =====
CHROMA_PERSIST_DIR=./chroma_db

# ===== 大模型 API =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
