# ========== 应用 ==========
APP_NAME=大学生学习与求职智能助手
APP_VERSION=0.1.0
DEBUG=true

# ========== 数据库 ==========
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/campus_assistant?charset=utf8mb4

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== JWT ==========
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_BLACKLIST_ENABLED=true

# ========== DeepSeek LLM ==========
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== Bocha 联网搜索 ==========
BOCHA_API_KEY=your-api-key

# ========== RAG ==========
RAG_TOP_K=4
RAG_MIN_SCORE=1.5
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=4
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=3600

# ========== Chroma 向量库 ==========
CHROMA_SERVER_URL=http://127.0.0.1:8001
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# ========== 文档上传 ==========
UPLOAD_STORAGE_DIR=./uploads
UPLOAD_MAX_SIZE=52428800
UPLOAD_ALLOWED_EXT=.pdf,.doc,.docx,.pptx,.txt,.md

# ========== 限流 ==========
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_LOGIN_ACCT=5
RATE_LIMIT_LOGIN_IP=20

# ========== 跨域 ==========
CORS_ORIGINS=["http://localhost:5173"]

# ========== 日志 ==========
LOG_LEVEL=INFO

# ========== Grill 面试模式 ==========
GRILL_RESUME_MIN_SCORE=2.7
